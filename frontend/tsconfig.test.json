{
  // Tests run in Node with vitest, so they also get Node's types (for reading the fixtures).
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/**/__tests__"
  ],
  "exclude": []
}
